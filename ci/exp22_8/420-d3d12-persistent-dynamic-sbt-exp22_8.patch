+// EXP22.8 transient isolation. These effects are rendered by the legacy
+// transparent/additive pass and do not need BLAS/TLAS or reflection SBT entries.
+// Keep the classification conservative: opaque world/model materials remain
+// eligible, while decals, smoke/puffs, muzzle flashes and additive particles
+// are excluded before any mesh upload or acceleration-structure work.
+static qboolean RB_EXP228ShaderNameContains(const shader_t* shader, const char* token)
+{
+	char lowerName[MAX_QPATH];
+	if (!shader || !token || !token[0])
+		return qfalse;
+	Q_strncpyz(lowerName, shader->name, sizeof(lowerName));
+	Q_strlwr(lowerName);
+	return strstr(lowerName, token) ? qtrue : qfalse;
+}
+
+static uint32_t RB_EXP228ClassifyTransientFlags(
+	const shader_t* shader,
+	const trRefEntity_t* entity)
+{
+	if (!shader)
+		return GL_RAYTRACING_INSTANCE_FLAG_NONE;
+
+	uint32_t flags = GL_RAYTRACING_INSTANCE_FLAG_NONE;
+	const qboolean nonModelTransient =
+		entity && entity != &tr.worldEntity && entity->e.reType != RT_MODEL;
+	const qboolean muzzle =
+		RB_EXP228ShaderNameContains(shader, "muzzle") ||
+		RB_EXP228ShaderNameContains(shader, "muzz") ||
+		RB_EXP228ShaderNameContains(shader, "gunflash") ||
+		RB_EXP228ShaderNameContains(shader, "weaponflash") ||
+		RB_EXP228ShaderNameContains(shader, "mflash");
+	const qboolean namedTransient = muzzle ||
+		RB_EXP228ShaderNameContains(shader, "smoke") ||
+		RB_EXP228ShaderNameContains(shader, "puff") ||
+		RB_EXP228ShaderNameContains(shader, "particle") ||
+		RB_EXP228ShaderNameContains(shader, "spark") ||
+		RB_EXP228ShaderNameContains(shader, "tracer") ||
+		RB_EXP228ShaderNameContains(shader, "shell") ||
+		RB_EXP228ShaderNameContains(shader, "brass") ||
+		RB_EXP228ShaderNameContains(shader, "casing") ||
+		RB_EXP228ShaderNameContains(shader, "impact") ||
+		RB_EXP228ShaderNameContains(shader, "scorch") ||
+		RB_EXP228ShaderNameContains(shader, "blood") ||
+		RB_EXP228ShaderNameContains(shader, "dust") ||
+		RB_EXP228ShaderNameContains(shader, "debris") ||
+		RB_EXP228ShaderNameContains(shader, "explosion") ||
+		RB_EXP228ShaderNameContains(shader, "flare");
+	qboolean additiveStage = qfalse;
+	for (int stageIndex = 0; stageIndex < MAX_SHADER_STAGES; ++stageIndex)
+	{
+		const shaderStage_t* stage = shader->stages[stageIndex];
+		if (!stage || !stage->active)
+			continue;
+		const unsigned srcBlend = stage->stateBits & GLS_SRCBLEND_BITS;
+		const unsigned dstBlend = stage->stateBits & GLS_DSTBLEND_BITS;
+		if (dstBlend == GLS_DSTBLEND_ONE && srcBlend != GLS_SRCBLEND_ZERO)
+		{
+			additiveStage = qtrue;
+			break;
+		}
+	}
+	const qboolean sortedTransient =
+		shader->sort == SS_DECAL ||
+		shader->sort >= SS_ALMOST_NEAREST ||
+		(shader->entityMergable && shader->sort > SS_OPAQUE);
+
+	if (nonModelTransient || namedTransient || sortedTransient || additiveStage)
+		flags |= GL_RAYTRACING_INSTANCE_FLAG_TRANSIENT |
+			GL_RAYTRACING_INSTANCE_FLAG_NO_REFLECTION;
+	if (muzzle)
+		flags |= GL_RAYTRACING_INSTANCE_FLAG_MUZZLE;
+	return flags;
+}
+
+static void RB_EXP228ExcludeDXRSurface(
+	trDXRMesh_t* mesh,
+	int surfaceId,
+	uint32_t instanceFlags)
+{
+	if (!mesh || surfaceId < 0 || surfaceId >= MAX_DXR_SURFACES)
+		return;
+	trDXRSurface_t* surf = &mesh->dxrSurfaces[surfaceId];
+	if (surf->dxrInstanceHandle)
+	{
+		glRaytracingDeleteInstance(surf->dxrInstanceHandle);
+		surf->dxrInstanceHandle = 0;
+	}
+	if (surf->dxrMeshHandle)
+	{
+		glRaytracingDeleteMesh(surf->dxrMeshHandle);
+		surf->dxrMeshHandle = 0;
+	}
+	surf->cachedTransformValid = 0;
+	surf->cachedAlbedoTexture = 0;
+	surf->geometryHash = 0;
+	glRaytracingExp228RecordTransientSkip(instanceFlags);
+}
